# Copy to .env for local runs. Never commit real values.
# In production these are mounted from Secret Manager onto the Cloud Run service.

GOOGLE_CLOUD_PROJECT=onwan-production
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3.6-flash

# Shared secret required in the X-Onwan-Run-Key header on POST /run.
RUN_KEY=

# Resend (https://resend.com) — free tier, no domain verification needed.
RESEND_API_KEY=
DIGEST_FROM=Onwan Grants <onboarding@resend.dev>
DIGEST_TO=
